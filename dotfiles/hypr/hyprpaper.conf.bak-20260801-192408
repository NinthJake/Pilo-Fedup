# hyprpaper — wallpaper daemon (hyprlang block syntax, hyprpaper >= 0.8)
# Docs: https://wiki.hyprland.org/Hyprland-Ecosystem/hyprpaper/

# Subtle radial gradient in vague.nvim bg tones, generated into this repo.
# Swap wallpaper.png for any image you like — it's tracked by fedup/auto_push.
# NOTE: hyprpaper does not expand ~ — absolute paths required.
wallpaper {
    monitor =
    path = ~/.config/hypr/wallpaper.png
    fit_mode = cover
}

splash = false
ipc = on
